{
  "name": "whatsauto.js",
  "type": "module",
  "version": "2.0.5",
  "description": "Easy WhatsApp Automation with Session",
  "files": [
    "dist/**/*"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "tsc && node ./dist/index.js",
    "example": "tsc && node example/single.js",
    "test": "tsc && node --test",
    "typecheck": "tsc --noEmit",
    "check:baileys": "bash scripts/check-baileys.sh"
  },
  "keywords": [
    "wa",
    "whatsapp",
    "auto",
    "automation",
    "baileys",
    "session"
  ],
  "author": "freack21",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.13.2",
    "colorette": "^2.0.20",
    "file-type": "^21.3.4",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.0",
    "mime": "^3.0.0",
    "node-webpmux": "^3.2.0",
    "pino": "^10.1.0",
    "qrcode-terminal": "^0.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/freack21/whatsauto.js.git"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/fs-extra": "^11.0.4",
    "@types/mime": "^3.0.1",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.7.2"
  }
}
