# Copy to .env and adjust.

# Display name used in menus and replies
BOT_NAME=WhatsAuto Bot

# Session id; credentials are stored in <CREDENTIALS_DIR>/<SESSION_ID>_creds
SESSION_ID=main
CREDENTIALS_DIR=wa_creds

# Leave empty to log in with a QR code. Set a phone number (country code + number)
# to log in with a pairing code instead.
PAIRING_NUMBER=

# Comma-separated owner phone numbers (country code + number), e.g. 6281234567890
OWNER_NUMBERS=

# Characters accepted as command prefix, and whether commands also work without one
# (quoted, because an unquoted "#" starts a comment in .env files)
PREFIXES="!.-/#"
PREFIXLESS=false

# Default reply language for new users: en or id
DEFAULT_LANG=id

# Where runtime data (users.json) is stored
DATA_DIR=data
